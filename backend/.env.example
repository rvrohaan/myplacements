DATABASE_URL=postgresql://postgres:password@localhost:5432/myplacements
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ANTHROPIC_API_KEY=your-anthropic-api-key
ENVIRONMENT=development
# Apex domain colleges live under as subdomains (rit.myplacements.in).
BASE_DOMAIN=myplacements.in

# -- Outbound email (Resend), used for password-setup / invite links ----------
# Create an API key at resend.com and verify the sending domain (SPF + DKIM).
# Leave blank to disable sending: invite links are still generated and can be
# copied or shared from the UI.
RESEND_API_KEY=
MAIL_FROM=MyPlacement.AI <noreply@myplacements.in>

# Password-setup link lifetimes and the scheme used when building them.
INVITE_EXPIRY_HOURS=168
STUDENT_INVITE_EXPIRY_HOURS=720
LINK_SCHEME=https

# -- Daily updates ------------------------------------------------------------
# Timestamps are stored in UTC, but "today" and the filing cutoff are local
# questions. Set this to the colleges' own timezone.
LOCAL_TIMEZONE=Asia/Kolkata
# Shared secret for the unattended scheduler that sends the filing reminders and
# the leadership digest. Leave blank to disable the endpoint entirely; when set,
# point an hourly cron at it:
#   curl -fsS -X POST -H "X-Cron-Token: $CRON_TOKEN" #     https://admin.myplacements.in/api/daily-updates/cron/run
CRON_TOKEN=

# Replies to invite emails go here (the From address is a no-reply).
MAIL_REPLY_TO=help@myplacements.in
